{
  "name": "context-anki",
  "version": "0.3.1",
  "description": "从整句中选择目标词并创建带上下文的 Anki 卡片",
  "homepage": "https://github.com/geekhuashan/bob-context-anki",
  "repository": {
    "type": "git",
    "url": "https://github.com/geekhuashan/bob-context-anki.git"
  },
  "bugs": {
    "url": "https://github.com/geekhuashan/bob-context-anki/issues"
  },
  "author": "geekhuashan",
  "license": "MIT",
  "main": "src/main.js",
  "keywords": [
    "bob-plugin",
    "bobplugin",
    "translate",
    "anki",
    "anki-connect",
    "cefr"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "clear": "rimraf ./dist && rimraf ./release",
    "initInfo": "node ./scripts/init-info.js",
    "dev": "rollup -c rollup.config.js --bundleConfigAsCjs --watch",
    "build": "npm run clear && npm run initInfo && rollup -c rollup.config.js --bundleConfigAsCjs && node ./scripts/build-zip.js",
    "type-check": "tsc --noEmit --allowJs",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run type-check",
    "verify:release": "node ./scripts/verify-release.js",
    "release:build": "npm run check && npm run build && npm run verify:release",
    "generate:cefr": "node scripts/generate-cefr-data.js",
    "type-check:watch": "tsc --noEmit --allowJs --watch"
  },
  "devDependencies": {
    "@bob-translate/types": "^1.0.2",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/node": "^22.14.1",
    "adm-zip": "^0.5.5",
    "fs-extra": "^10.0.0",
    "rimraf": "^6.0.1",
    "rollup": "4.40.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "5.7.3",
    "xlsx": "0.18.5"
  }
}
