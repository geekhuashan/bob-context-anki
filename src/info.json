{
  "identifier": "com.huashan.bobplug.context-anki-probe",
  "category": "translate",
  "version": "0.4.0",
  "name": "上下文词卡",
  "summary": "从整句中选择目标词并创建带上下文的 Anki 卡片",
  "author": "geekhuashan",
  "homepage": "https://github.com/geekhuashan/bob-context-anki",
  "icon": "001",
  "minBobVersion": "1.20.0",
  "options": [
    {
      "identifier": "annotationApiKey",
      "type": "text",
      "title": "注释 API Key",
      "defaultValue": "",
      "textConfig": {
        "type": "secure",
        "height": 40,
        "placeholderText": "sk-..."
      },
      "desc": "只在点击新词建卡时使用，由 Bob 安全保存，不会写入插件文件。"
    },
    {
      "identifier": "annotationApiBaseUrl",
      "type": "text",
      "title": "注释 API 地址",
      "defaultValue": "https://api.minimaxi.com",
      "textConfig": {
        "type": "visible",
        "height": 40,
        "placeholderText": "https://api.minimaxi.com"
      },
      "desc": "OpenAI 兼容地址；可填写服务根地址、/v1 地址或完整 chat/completions 地址。"
    },
    {
      "identifier": "annotationModel",
      "type": "text",
      "title": "注释模型",
      "defaultValue": "MiniMax-M2.1",
      "textConfig": {
        "type": "visible",
        "height": 40,
        "placeholderText": "MiniMax-M2.1"
      },
      "desc": "短结构化注释不启用推理。"
    },
    {
      "identifier": "minimumCefrLevel",
      "type": "menu",
      "title": "最低词汇等级",
      "defaultValue": "B2",
      "menuValues": [
        {
          "title": "A1 及以上（显示全部）",
          "value": "A1"
        },
        {
          "title": "A2 及以上",
          "value": "A2"
        },
        {
          "title": "B1 及以上",
          "value": "B1"
        },
        {
          "title": "B2 及以上（推荐）",
          "value": "B2"
        },
        {
          "title": "仅词表外 / 专业词",
          "value": "UNKNOWN"
        }
      ],
      "desc": "按 CEFR-J Wordlist 1.6 过滤。词表覆盖 A1-B2；未收录的技术词会单独保留。"
    },
    {
      "identifier": "ignoredWords",
      "type": "text",
      "title": "已认识词",
      "defaultValue": "",
      "textConfig": {
        "type": "visible",
        "height": 56,
        "placeholderText": "多个单词用空格或逗号分隔"
      },
      "desc": "这些词不会出现在候选列表中，不区分大小写。"
    }
  ]
}
